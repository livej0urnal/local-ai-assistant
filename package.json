{
  "name": "local-ai-assistant",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ensure": "node scripts/ensure-vite.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "test:quick-start": "node --experimental-strip-types --test tests/quick-start.test.mjs",
    "test": "npm run test:quick-start && cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:dev": "tauri dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
